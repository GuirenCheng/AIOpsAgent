# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿把真实密钥提交到版本库）

# 应用配置
APP_NAME=AIOpsAgent
DEBUG=False
HOST=0.0.0.0
PORT=9900

# DashScope 配置（必填）
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus 配置（本地 Docker）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# MinIO 凭证（Milvus 对象存储，与 vector-database.yml 共用；请用 `openssl rand -hex 16` 生成强口令）
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-strong-password

# RAG 配置
RAG_TOP_K=3
RAG_MODEL=qwen-max
# 意图分类模型（统一入口 /api/agent 用；留空则用 RAG_MODEL）。分类是轻量任务，可填 qwen-plus 省成本。
INTENT_MODEL=

# RAG 防幻觉配置
# 事实型 RAG 建议低温度，降低自由发挥
RAG_TEMPERATURE=0.2
# 检索相关性阈值(0~1)，低于此值的检索结果视为不可靠、不喂给模型
RAG_RELEVANCE_THRESHOLD=0.5
# 对话历史最多保留条数(含系统消息)，超出则自动裁剪
RAG_HISTORY_MAX_MESSAGES=7
# 模型调用失败重试次数
RAG_MODEL_RETRY=2
# 降级模型名（空 = 不启用；如 qwen-plus），主模型反复失败时切换
RAG_FALLBACK_MODEL=
# 单次对话最多工具调用次数（防死循环）
RAG_MAX_TOOL_CALLS=8

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# 以下变量由 MCP 独立进程（mcp_servers/*.py）从自身环境读取，不经过 app 配置：
# 配置后 cls_server 走真实腾讯云 CLS（需先 pip install tencentcloud-sdk-python-cls），
# 否则依次回退到本地文件（data/cls/*.jsonl）→ Mock 模拟数据。
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=ap-guangzhou

# monitor_server：安装 psutil 后 get_host_metrics 返回真实主机指标；
# 配置 data/monitor/*.csv 后时序工具返回真实指标，否则返回模拟数据。

# 写操作后端（A2：restart_service / rollback_service 的真实实现切换）
# 由 mcp_servers/write_ops.py 直接读环境变量；可选 mock(默认，只模拟) / systemd / k8s / tencent。
# systemd = 真实 `systemctl restart` + 「版本目录 + current 软链」回滚（见 SYSTEMD_DEPLOY_ROOT）。
# k8s / tencent 目前是占位，选中会显式报错（绝不静默回退 mock），待真实接入时实现。
WRITE_OP_BACKEND=mock

# systemd 后端部署根目录（WRITE_OP_BACKEND=systemd 时生效，默认 /srv）：
# 期望布局 {SYSTEMD_DEPLOY_ROOT}/{service}/releases/<version>/ + current -> releases/<version> 软链；
# 回滚 = current 软链切回上一个版本目录后 `systemctl restart`。缺软链/版本不足会 fail-closed。
# SYSTEMD_DEPLOY_ROOT=/srv

# 写操作服务白名单（A2）：允许被自动重启/回滚的服务名，逗号分隔。
# 空 = 全部拒绝（fail-closed）。本地演示可填 mock 场景的服务名，如：
# HARNESS_WRITE_ALLOWLIST=web,data-sync-service

# Harness 后端（C1：多实例高可用）
# in_process = 进程内 asyncio 原语（默认，单 worker 零依赖）；
# redis = 分布式锁/审批（**多 worker `uvicorn --workers N` 部署时必须设 redis**，
#         否则进程内锁/审批跨 worker 失效，写操作互斥被打破）。
HARNESS_BACKEND=in_process
REDIS_URL=redis://localhost:6379/0
# 分布式锁租约 TTL（秒）：进程崩溃后自动释放，避免死锁
HARNESS_LOCK_REDIS_TTL_SECONDS=30
# uvicorn 进程数（多 worker 高可用；docker compose 里传给容器 CMD 的 --workers）。
# >1 时必须同时设 HARNESS_BACKEND=redis（否则启动会打醒目的多 worker 安全告警）。
WORKERS=1

# 通知通道（B2：审批创建 + 告警诊断结论推送）
# channel 可选 log(默认，只写日志) / dingtalk / wecom / email；凭据没配齐时自动回退 log
NOTIFY_CHANNEL=log
# 审批通知里附带审批列表入口的基础地址（如 http://your-server:9900），留空则不附
NOTIFY_BASE_URL=
# 一键审批链接有效期（秒，默认 1800=30 分钟）：审批通知里「批准/拒绝」回调 token 的时效。
# 生成一键审批链接还需 AUTH_TOKEN_SECRET（无签名密钥则不生成链接，降级为只发审批列表）。
APPROVAL_LINK_TTL_SECONDS=1800
# 钉钉群机器人（加签可选：secret 与 access_token 配套；不加签只填 webhook url）
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
# 企业微信群机器人
WECOM_WEBHOOK_URL=
# 邮件（SMTP，默认 SSL 465）
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Milvus 数据安全（维度不匹配时是否允许自动删除并重建 collection；默认 false，禁止静默丢数据）
MILVUS_VECTOR_DIM=1024
MILVUS_ALLOW_DIMENSION_MIGRATION=false

# 生产加固
# 鉴权：开启后 /api/* 需登录（Authorization: Bearer <token>）或携带 X-API-Key（服务账号/向后兼容）
API_AUTH_ENABLED=false
API_AUTH_KEY=change-me-strong-api-key
# RBAC（C2）：用户名+密码登录 → 签发无状态 HMAC token
# AUTH_TOKEN_SECRET 为 token 签名密钥；API_AUTH_ENABLED=true 时必填，否则登录/校验都失败。
# 请用 `openssl rand -hex 32` 生成强随机值，切勿用示例值。
AUTH_TOKEN_SECRET=
# token 有效期（秒），默认 24 小时
AUTH_TOKEN_TTL_SECONDS=86400
# 首次启动（用户表为空）自动创建的初始管理员账号；密码留空则随机生成并打印到日志一次
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
# 用户库路径（独立于审计库）
AUTH_DB_PATH=data/users.sqlite
# 单 IP 限流（每分钟请求数）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
# CORS（逗号分隔允许来源；留空则仅同源访问，不发送 CORS 头）
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
# 单个问题最大长度
MAX_QUESTION_LENGTH=4000
# API 文档（/docs /redoc /openapi.json）对外暴露开关；生产建议设为 false
ENABLE_DOCS=true

# 会话持久化（LangGraph checkpointer 落盘到 SQLite；需 pip install langgraph-checkpoint-sqlite）
SESSION_STORE_ENABLED=true
SESSION_STORE_DB_PATH=data/checkpoints.sqlite
